Options -Indexes

# Bloqueia acesso direto a arquivos sensíveis e de configuração do projeto
<FilesMatch "(?i)^(\.git.*|\.env.*|.*\.md|.*\.sh|package(-lock)?\.json|.*\.stackdump|.*\.sql|.*\.bak.*)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /sismil/

  # Bloqueia acesso à pasta .git via web
  RewriteRule ^\.git - [F,L,NC]
  RewriteRule ^docs/ - [F,L,NC]

  # ==============================================================
  # PRODUÇÃO: Descomentar o bloco abaixo para forçar HTTPS
  # Necessário após instalar o certificado SSL no servidor.
  # NÃO ativar em desenvolvimento local (XAMPP sem HTTPS).
  # ==============================================================
  # RewriteCond %{HTTPS} off
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Ignora a pasta backend para que as APIs continuem funcionando
  RewriteCond %{REQUEST_URI} ^/sismil/backend/ [NC]
  RewriteRule ^ - [L]

  # Redireciona tudo que não for um arquivo existente para o index.html (SPA)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /sismil/index.html [L]
</IfModule>

# LOW-01: Headers de segurança HTTP
<IfModule mod_headers.c>
  # Impede que o site seja carregado em iframes de outros domínios (clickjacking)
  Header always set X-Frame-Options "SAMEORIGIN"

  # Impede que o browser "adivinhe" o tipo de conteúdo (MIME sniffing)
  Header always set X-Content-Type-Options "nosniff"

  # Controla informações de referer enviadas em requisições
  Header always set Referrer-Policy "strict-origin-when-cross-origin"

  # Proteção XSS para browsers legados
  Header always set X-XSS-Protection "1; mode=block"

  # Política de segurança de conteúdo
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob:; connect-src 'self' https://viacep.com.br"

  # Evita cache persistente do navegador para arquivos HTML e JS da SPA
  <FilesMatch "\.(html|js|css)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Remove cabeçalho que revela a versão do servidor
  Header always unset X-Powered-By
  Header always unset Server
</IfModule>

